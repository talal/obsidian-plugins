	},
	"devDependencies": {
		"@types/node": "^24.1.0",
		"obsidian": "latest",
		"typescript": "^7.0.2",
		"vite-plus": "latest"
	},
	"packageManager": "npm@11.17.0",
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
