{
	"name": "obsidian-plugins",
	"private": true,
	"workspaces": [
		"plugins/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"check:types": "vp check --no-fmt --no-lint",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"test": "vp run -r test"
	},
	"devDependencies": {
		"@playwright/cli": "^0.1.18",
		"@types/node": "^24.1.0",
		"chrome-devtools-mcp": "^1.8.0",
		"obsidian": "latest",
		"typescript": "^7.0.2",
		"vite-plus": "latest"
	},
	"packageManager": "npm@11.17.0",
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
