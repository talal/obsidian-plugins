{
	"name": "flashcards",
	"version": "0.1.0",
	"description": "Spaced repetition flashcards plugin for Obsidian",
	"license": "0BSD",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "npm run build:wasm && vp build",
		"build:wasm": "cd ../../crates/flashcards-wasm && wasm-pack build --target web --release",
		"build:wasm:dev": "cd ../../crates/flashcards-wasm && wasm-pack build --target web --dev",
		"check": "vp check",
		"check:types": "vp check --no-fmt --no-lint",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"test": "vp test"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"svelte": "^5.56.10"
	}
}
