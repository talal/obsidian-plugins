{
	"name": "typst-math",
	"version": "0.1.0",
	"description": "Typst Math syntax plugin for Obsidian",
	"license": "0BSD",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "npm run build:wasm && vp build",
		"build:wasm": "cd ../../crates/typst-math-wasm && wasm-pack build --target web --release",
		"build:wasm:dev": "cd ../../crates/typst-math-wasm && wasm-pack build --target web --dev",
		"check": "vp check",
		"check:types": "vp check --no-fmt --no-lint",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"test": "vp test"
	}
}
